      targetAmount: 1
      currentAmount: 0
    - targetPrefab: {fileID: 3634079177299486472, guid: bc7ad76736acc79488393748bbaeaa86, type: 3}
      targetAmount: 1
      currentAmount: 0
    tutorialTitle: "DENEY F\xD6Y\xDC #07: B\xDCY\xDCK USTA SINAVI"
    tutorialContent: "Geldik laboratuvar\u0131n en zorlu s\u0131nav\u0131na! Bir
      yanda asidik karakterli Karbonik Asit (H<sub>2</sub>CO<sub>3</sub>), di\u011Fer
      yanda do\u011Fada mermer veya kire\xE7 ta\u015F\u0131 olarak bildi\u011Fimiz
      devasa Kalsiyum Karbonat (CaCO<sub>3</sub>) yap\u0131s\u0131. Bu matriste sadece
      usta kimyagerler hayatta kalabilir. \\n\\n<b>Laboratuvar G\xF6revi:</b> \u0130ki
      karma\u015F\u0131k molek\xFCl\xFC daralan matris alan\u0131nda stratejik olarak
      sentezle. Jokerlerini (Par\xE7ala) ve Asistan\u0131 ak\u0131ll\u0131ca kullan!"
    tutorialLargeSprite1: {fileID: 21300000, guid: 5b2103234b416ac4c89c8c5715071214, type: 3}
    tutorialLargeSprite2: {fileID: 21300000, guid: e18450fbe2a3b70438a9400986292254, type: 3}
  currentLevelIndex: 0
