      targetAmount: 1
      currentAmount: 0
    tutorialTitle: "DENEY F\xD6Y\xDC #06: AS\u0130T SENTEZ\u0130"
    tutorialContent: "Karbonik asit (H<sub>2</sub>CO<sub>3</sub>), ya\u011Fmur suyunun
      atmosferdeki Karbondioksit ile birle\u015Fmesiyle do\u011Fal olarak olu\u015Fan
      zay\u0131f bir asittir. Gazozlar\u0131n i\xE7indeki o ferahlat\u0131c\u0131
      baloncuklar\u0131n s\u0131rr\u0131 da tam olarak bu molek\xFCld\xFCr! \\n\\n<b>Laboratuvar
      G\xF6revi:</b> Hidrojen (H), Karbon (C) ve Oksijen (O) atomlar\u0131n\u0131
      hatas\u0131z bir \u015Fekilde birle\u015Ftirerek H<sub>2</sub>CO<sub>3</sub>
      molek\xFCl\xFCn\xFC ba\u015Far\u0131yla sentezle."
    tutorialLargeSprite1: {fileID: 21300000, guid: fdf6ce7340a5427469cbb03caa160ffa, type: 3}
    tutorialLargeSprite2: {fileID: 21300000, guid: 5b2103234b416ac4c89c8c5715071214, type: 3}
  - levelName: Level 7
    startingTileCount: 7
    spawnPool:
    - elementPrefab: {fileID: 3634079177299486472, guid: 293d81e9e56243149b4c147559fe8972, type: 3}
      spawnWeight: 15
    - elementPrefab: {fileID: 3634079177299486472, guid: 1e729ce8f726e3f429fe863283cdc9a4, type: 3}
