    turkish: '?'
    english: '?'
  - key: recipebook.ring_value
    turkish: '{0}/{1}'
    english: '{0}/{1}'
  - key: recipebook.title
    turkish: "TAR\u0130F DEFTER\u0130"
    english: "TAR\u0130F DEFTER\u0130"
  - key: registration.anonymous
    turkish: "G\xF6zlemci Kayd\u0131 (\u0130simsiz A\u011F)"
    english: "G\xF6zlemci Kayd\u0131 (\u0130simsiz A\u011F)"
  - key: registration.email_optional
    turkish: "<color=#ADB5BD>Laboratuvar Kayd\u0131 (\u0130ste\u011Fe Ba\u011Fl\u0131)
      - \u0130lerlemeni farkl\u0131 cihazlarda ta\u015F\u0131</color>"
    english: "<color=#ADB5BD>Laboratuvar Kayd\u0131 (\u0130ste\u011Fe Ba\u011Fl\u0131)
      - \u0130lerlemeni farkl\u0131 cihazlarda ta\u015F\u0131</color>"
  - key: registration.invalid_email
    turkish: "<color=red>Kabul edilmeyen E-Posta format\u0131!</color>"
    english: "<color=red>Kabul edilmeyen E-Posta format\u0131!</color>"
  - key: registration.mentor_required
    turkish: "\xD6nce bir mentor se\xE7"
    english: "\xD6nce bir mentor se\xE7"
  - key: registration.name_required
    turkish: "Kimyager ad\u0131n\u0131 yazmal\u0131s\u0131n"
    english: "Kimyager ad\u0131n\u0131 yazmal\u0131s\u0131n"
  - key: registration.no_mentor_chosen
    turkish: "<color=#ADB5BD>Mentor se\xE7ilmedi...</color>"
    english: "<color=#ADB5BD>Mentor se\xE7ilmedi...</color>"
  - key: system.matrix_reshuffled
    turkish: "MATR\u0130S YEN\u0130DEN D\xDCZENLEND\u0130"
    english: "MATR\u0130S YEN\u0130DEN D\xDCZENLEND\u0130"
  - key: undo.explain
    turkish: "Kimyada baz\u0131 reaksiyonlar geri d\xF6nd\xFCr\xFClebilir. Bu i\u015Flem
      matrisi bir \xF6nceki hamleye geri al\u0131r.\n\nBedeli: <color={0}>{1} Puan</color>\nKalan
      Hakk\u0131n: <color={2}>{3}</color>"
    english: "Kimyada baz\u0131 reaksiyonlar geri d\xF6nd\xFCr\xFClebilir. Bu i\u015Flem
      matrisi bir \xF6nceki hamleye geri al\u0131r.\n\nBedeli: <color={0}>{1} Puan</color>\nKalan
      Hakk\u0131n: <color={2}>{3}</color>"
