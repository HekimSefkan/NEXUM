    turkish: <sprite="NexumSymbols" name="nope">
    english: <sprite="NexumSymbols" name="nope">
  - key: reaction.no_product_fallback
    turkish: X
    english: X
  - key: recipebook.button
    turkish: "TAR\u0130F DEFTER\u0130"
    english: "TAR\u0130F DEFTER\u0130"
  - key: recipebook.counter
    turkish: "{0} / {1} tepkime ke\u015Ffedildi"
    english: "{0} / {1} tepkime ke\u015Ffedildi"
  - key: recipebook.discovered
    turkish: "YEN\u0130 TEPK\u0130ME KAYDED\u0130LD\u0130"
    english: "YEN\u0130 TEPK\u0130ME KAYDED\u0130LD\u0130"
