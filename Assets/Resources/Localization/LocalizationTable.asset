    turkish: '{0} <sprite="NexumSymbols" name="arrow"> {1}'
    english: '{0} <sprite="NexumSymbols" name="arrow"> {1}'
  - key: reaction.equation_fallback
    turkish: '{0} -> {1}'
    english: '{0} -> {1}'
  - key: reaction.inputs
    turkish: '{0} + {1}'
    english: '{0} + {1}'
