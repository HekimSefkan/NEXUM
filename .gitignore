# =============================================
# Unity 2022 LTS - Kapsamlı .gitignore
# =============================================

# ---- Unity Tarafından Oluşturulan Klasörler ----
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# ---- Bellek Anlık Görüntüleri ----
/[Mm]emoryCaptures/

# ---- Kayıt Varlıkları ----
/[Rr]ecordings/

# ---- Asset Imports ----
/[Aa]ssets/AssetStoreTools*

# ---- Visual Studio / Rider / IDE Dosyaları ----
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# ---- MonoDevelop ----
/*.userprefs

# ---- OS Tarafından Oluşturulan Dosyalar ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---- Derleme Çıktıları ----
*.dll
*.exe
*.apk
*.aab
*.unitypackage
*.app

# ---- Assets altındaki eklenti DLL'leri takip edilmeli (örn. DOTween) ----
!/[Aa]ssets/**/*.dll
!/[Aa]ssets/**/*.mdb
!/[Aa]ssets/**/*.pdb

# ---- Crash Raporları ----
sysinfo.txt
crashlytics-build.properties

# ---- Addressables ----
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ---- TextMeshPro ----
# Assets/TextMesh Pro/ (TMP Essentials) takip edilmeli: sahneler font/shader/ayar asset'lerine referans veriyor

# ---- Plastic SCM ----
ignore.conf
*.private.0
*.private

# ---- Gradle (Android Build) ----
/[Aa]ssets/[Pp]lugins/[Aa]ndroid/**/build/
*.gradle
local.properties
.gradle/

# ---- NuGet ----
# Not: "packages/" kuralı core.ignorecase=true iken Packages/manifest.json'u dışladığı için kaldırıldı
*.nupkg

# ---- Profiler Verileri ----
*.data
*.raw

# ---- Annotation / Bakery Lightmaps ----
/[Aa]ssets/[Ss]cenes/**/*.lightingdata*

# ---- Unity Package Manager ----
# Packages klasörü takip edilmeli, ancak cache edilmemeli
# /Packages/ klasörünü DIŞLAMIYORUZ (manifest.json gerekli)

# ---- Proje Dışı Kaynaklar (ham görseller, APK, PDF'ler) ----
/NEXUM stuff/

# ---- Geçici Dosyalar ----
*.swp
*.swo
*~
\#*\#
